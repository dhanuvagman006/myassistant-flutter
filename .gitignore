# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
# pubspec.lock IS committed: for an app it pins what every build resolves.
.metadata
.dart-plugins/
.pub-cache/
.pub/
coverage/

# IDE
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Android
android/local.properties
android/.gradle/
android/app/google-services.json
android/app/src/main/assets/flutter_assets/
*.keystore
*.jks

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/flutter_export_environment.sh
ios/Runner/GoogleService-Info.plist
ios/Flutter/ephemeral/
ios/Flutter/Generated.xcconfig

# Secrets
.env
.env.*
!.env.example
!.env.*.example

# App Check debug token for App Distribution builds (tool/build_apk.sh
# compiles it in) — never commit
android/app-check-debug-token.txt

# Release signing — never commit
android/key.properties
android/app/*.jks
android/app/*.keystore

# Data dumps / exports — never commit
*.csv
*.hprof
