<?xml version="1.0" encoding="utf-8"?>
<!--
  NO PERIODIC UPDATE. updatePeriodMillis is 0 on purpose: the widget
  shows one static button, so waking the app on a timer to redraw it
  would spend battery to change nothing. It is redrawn only when Android
  places it.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="80dp"
    android:minHeight="80dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/widget_task_description"
    android:previewLayout="@layout/widget_task"
    android:initialLayout="@layout/widget_task" />
