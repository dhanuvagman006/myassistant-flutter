<?xml version="1.0" encoding="utf-8"?>
<!--
  HAND THE ASSISTANT A JOB FROM THE HOME SCREEN.

  One tap target, deliberately: this widget does one thing. It is NOT a
  live conversation — tapping it opens a one-shot capture, the task goes
  to the server, and the answer arrives as a notification whenever it is
  done. See QuickTaskScreen on the Flutter side.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_orb"
            android:contentDescription="@string/widget_task_label" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_mic"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_task_label"
        android:textColor="#CFC4E4"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
