<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

<uses-permission android:name="android.permission.INTERNET"/>
<!-- Screen-time reporting. Special permission: granted only by the user in
     Settings > Special app access > Usage access, never via a dialog. -->
<uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
    tools:ignore="ProtectedPermissions"/>
<uses-permission android:name="android.permission.RECORD_AUDIO"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
<uses-permission android:name="android.permission.CAMERA"/>
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
<uses-permission android:name="android.permission.READ_CONTACTS"/>
<uses-permission android:name="android.permission.CALL_PHONE"/>
<uses-permission android:name="android.permission.SEND_SMS"/>
<!-- Wake-up reminders take over a locked screen like a clock alarm.
     Android 14+ gates this; ordinary reminders never use it. -->
<uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
<uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"/>
<!-- Network state — required for WebRTC ICE candidate gathering -->
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
<uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
<uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
<uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
<!-- Incoming-call guard: detect ringing/active calls so the assistant
     stops speaking immediately and releases the microphone. -->
<uses-permission android:name="android.permission.READ_PHONE_STATE"/>
<!-- "Any missed calls?" and the Missed calls card on Home: the phone's own
     call history, read on the phone (CallLogBridge). Asked the first time
     the owner asks about calls, never at launch. NOTE: declaring it puts it
     in permission_handler's Permission.phone group (strictest status wins),
     so phone checks use CallLogBridge's exact per-permission answer. -->
<uses-permission android:name="android.permission.READ_CALL_LOG"/>
<!-- AI call analysis, system-recorder mode: read the call recordings the
     phone's OWN dialer saves (Samsung records both sides cleanly; we
     never can from a normal app). Android 13+ uses READ_MEDIA_AUDIO,
     older phones the legacy storage permission. -->
<uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
<!-- Auto-understood documents mirror their events (exam slots, meetings)
     into the user's own calendar. Read is required by Android to insert
     with a calendar id; nothing is ever read back beyond that id. -->
<uses-permission android:name="android.permission.READ_CALENDAR"/>
<uses-permission android:name="android.permission.WRITE_CALENDAR"/>
<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
    android:maxSdkVersion="32"/>
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
<!-- Shortcuts (build 120): "phone on silent" and Do Not Disturb. Android
     still asks the owner once, on its own Do Not Disturb access page. -->
<uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
<!-- Sideloaded installs get aggressive OEM battery management (Realme/
     Oppo/Xiaomi especially), which delays or drops FCM and kills the
     background — the single biggest "works on my phone, breaks on my
     friend's" cause. Asked once, politely, after onboarding. -->
<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
<!-- Reminders must survive a reboot: the boot receiver below re-arms them. -->
<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
<uses-permission android:name="android.permission.USE_BIOMETRIC"/>
<uses-permission android:name="android.permission.WAKE_LOCK"/>
<!-- Self-hosted APK update: lets the app hand the downloaded APK to the
     system installer. Remove for Play Store builds. -->
<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
<!-- "Uninstall <app>": opens Android's own uninstall confirmation, which
     the owner taps. Without it Android 9+ ignores the request. -->
<uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES"/>
    <!-- SETTING AN ALARM OR A TIMER NEEDS PERMISSION, not just visibility.
         Android names it outright and we never declared it:

           SecurityException: Permission Denial: starting Intent
           { act=android.intent.action.SET_TIMER
             cmp=com.sec.android.app.clockpackage/.TimerCTSHandleActivity }
           requires com.android.alarm.permission.SET_ALARM

         This is why `adb shell am start` succeeded every single time while
         the app never could — the shell holds the permission and we did
         not. It is a normal install-time permission with no runtime
         prompt, so declaring it is the whole fix. The <queries> block
         below lets us SEE the clock; this lets us START it. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>

    <queries>
        <!-- EVERY LAUNCHABLE APP ON THE PHONE.
             Android 11+ hides installed packages unless they are declared
             here, so "open BigBasket" could only ever work against a
             hardcoded list. This filter grants visibility of apps that
             have a launcher icon — which is exactly the set a person means
             when they say "open X" — without QUERY_ALL_PACKAGES, whose
             broad access needs a Play Store justification. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <!-- WHATSAPP, BY NAME. Package visibility for a LAUNCHER query
             covers opening the app, but reading its contact-data rows
             (the only way to place a WhatsApp call) and targeting the
             call intent at it both need the package declared outright. -->
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
        <!-- THE PHONE'S CLOCK. Android 11+ hides activities this app has
             not declared an interest in, and resolveActivity then returns
             null for a clock that is plainly installed — which is why
             "set a timer for 3 minutes" came back "I can't do that on
             this phone" on a Samsung with Samsung Clock sitting right
             there. `am start` from a shell is unrestricted, so the intents
             tested fine by hand and failed from inside the app. -->
        <intent><action android:name="android.intent.action.SET_ALARM"/></intent>
        <intent><action android:name="android.intent.action.SET_TIMER"/></intent>
        <intent><action android:name="android.intent.action.DISMISS_ALARM"/></intent>
        <intent><action android:name="android.intent.action.SNOOZE_ALARM"/></intent>
        <intent><action android:name="android.intent.action.DISMISS_TIMER"/></intent>
        <intent><action android:name="android.intent.action.SHOW_ALARMS"/></intent>
        <intent><action android:name="android.intent.action.SHOW_TIMERS"/></intent>
        <intent><action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH"/></intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- MAPS. "geo:" shows a place, "google.navigation:" starts
             turn-by-turn. Neither was declared, so on Android 11+ the
             launcher could not SEE Google Maps for either scheme and
             reported that nothing on this phone could open it — while
             Maps sat on the home screen. Declared, not assumed. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="google.navigation"/>
        </intent>
        <!-- PAY BY VOICE: upi://pay opens GPay / PhonePe / Paytm / BHIM
             prefilled. Undeclared, Android 11+ reports no app can open it. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="upi"/>
        </intent>
        <!-- CALL FOLLOW-UPS: an SMS, or a WhatsApp chat, with the message
             filled in for the user to send. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="sms"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="sms"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="whatsapp"/>
        </intent>
    </queries>

    <!-- No cleartext in release: the session token travels on every
         request, and the production API is HTTPS. Debug builds allow it
         (src/debug/AndroidManifest.xml) for a local dev server. -->
    <application
        android:label="myassistant"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Share-to-assistant: photos and PDFs shared from any app
                 (WhatsApp, gallery, file manager) land in the document
                 pipeline. Deliberately NOT */* — being a share target for
                 everything is how an app ends up in the way. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <!-- Share a link or a passage of text: "Share → Hari" from a
                 browser hands over the URL, which the assistant reads and
                 summarises. Text is not filed as a document. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
            </intent-filter>
            <!-- Documents, sheets, slides, CSV and text files: the server
                 reads the words out of these, so a shared spreadsheet or
                 deck is as answerable as a photo. Without these the app
                 was never offered for them (2026-09-27). The older
                 .doc/.xls/.ppt are kept and shareable, not read. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation"/>
                <data android:mimeType="application/msword"/>
                <data android:mimeType="application/vnd.ms-excel"/>
                <data android:mimeType="application/vnd.ms-powerpoint"/>
                <data android:mimeType="text/csv"/>
                <data android:mimeType="text/comma-separated-values"/>
                <data android:mimeType="text/tab-separated-values"/>
                <data android:mimeType="application/rtf"/>
                <data android:mimeType="text/rtf"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation"/>
                <data android:mimeType="application/msword"/>
                <data android:mimeType="application/vnd.ms-excel"/>
                <data android:mimeType="application/vnd.ms-powerpoint"/>
                <data android:mimeType="text/csv"/>
                <data android:mimeType="text/comma-separated-values"/>
                <data android:mimeType="text/tab-separated-values"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="application/rtf"/>
                <data android:mimeType="text/rtf"/>
            </intent-filter>
        </activity>

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
        <!-- Gift cards (2026-09-26): hands the finished card to WhatsApp
             (PosterShareBridge). Not exported; each share grants read on
             that one file only. -->
        <provider
            android:name=".PosterFileProvider"
            android:authorities="${applicationId}.posters"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/poster_paths" />
        </provider>
        <!-- Local reminder notifications: without these two receivers the
             AlarmManager broadcast reached NO component and "remind me at
             5" never rang — on any device, ever. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Push banners: a proper monochrome status icon and a named
             channel instead of the white square in "Miscellaneous". -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_hari" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="hari_default" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <!-- HOME-SCREEN WIDGET: one orb, one tap, one task handed over.
             No service, no periodic update — see TaskWidgetProvider.

             EXPORTED, deliberately. The widget broadcast comes from the
             system, and whether a non-exported receiver reliably gets it
             varies by launcher and OS version — a question only a device
             can answer, and a widget that never appears is the whole
             feature failing silently. The cost of exporting is nil here:
             the receiver handles APPWIDGET_UPDATE and nothing else, so
             the worst another app can do is ask it to redraw itself. -->
        <receiver
            android:name=".TaskWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_task_info" />
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- CONNECTED APPS (build 120): "Connect Notion" opens the consent page
             in a Custom Tab; the backend finishes the exchange and sends the
             tab to com.myassistant.myassistant://connected?result=… (a result
             word only, never a code or a token). This activity catches it and
             hands it to flutter_web_auth_2. MainActivity is not touched. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.myassistant.myassistant" android:host="connected"/>
            </intent-filter>
        </activity>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
</manifest>
